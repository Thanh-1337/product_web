# File .env.example (Dùng để push lên Git làm mẫu)
PORT=3000

# Cấu hình MySQL local
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=techstore

# Google OAuth (Để trống hoặc điền hướng dẫn)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET_HERE

SESSION_SECRET=your_random_secret_key